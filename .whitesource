{
  "scanSettings": {
    "configMode": "AUTO",
    "enableSCA": true,
    "baseBranches": [
      "main"
    ],
    "scanDependabotPR": true,
    "exploitability": true
  },
  "checkRunSettings": {
    "displayMode": "diff",
    "vulnerableCheckRunConclusionLevel": "failure",
    "failOnVulnerabilityMinSeverity": "High",
    "strictMode": "failure",
    "useMendCheckNames": true,
    "showWsInfo": false
  },
  "issueSettings": {
    "minSeverityLevel": "MEDIUM",
    "issueType": "DEPENDENCY"
  },
  "remediateSettings": {
    "enableRenovate": false,
    "workflowRules": {
      "enabled": true,
      "minVulnerabilityScore": 7.0,
      "maxVulnerabilityScore": 10.0
    }
  }
}
