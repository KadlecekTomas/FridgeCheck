{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "gen:types": "supabase gen types typescript --local > src/types/supabase-v2.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --config eslint.config.mjs --ext .ts,.tsx,.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/domain/**/*.ts' --test-coverage-exclude='src/domain/**/*.test.ts' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=98"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "^2.52.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "lucide-react": "^0.525.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
