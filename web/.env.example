# Public Supabase browser/server configuration.
# Use a publishable key for new deployments. Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Legacy compatibility only: current code can still fall back to
# NEXT_PUBLIC_SUPABASE_ANON_KEY while an existing deployment is migrated.
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new environments.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
